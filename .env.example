# Template only. Copy to .env.local and fill in there — .env.example is
# committed to git, .env.local is not.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://vqluppczclwevdjpjplw.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only, never exposed to the browser. Used by trusted server actions.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Resend (transactional email) ───────────────────────────────────────────
# Get at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sending domain, e.g. "Cohabispace <hello@cohabispace.com>"
RESEND_FROM_EMAIL="Cohabispace <onboarding@resend.dev>"

# ─── App ────────────────────────────────────────────────────────────────────
# Public origin used in invite links and absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
